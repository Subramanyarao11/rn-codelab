{
  "name": "rn-debug-labs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "rm -rf .next && next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "clean": "rm -rf .next node_modules out coverage .turbo *.tsbuildinfo",
    "reinstall": "npm run clean && npm install --legacy-peer-deps",
    "fresh": "npm run reinstall && npm run dev"
  },
  "dependencies": {
    "@babel/standalone": "^7.26.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@testing-library/dom": "^10.4.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "monaco-editor": "^0.52.2",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.7",
    "react-native": "^0.76.9",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "^4.9.2",
    "react-native-web": "^0.21.2",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
